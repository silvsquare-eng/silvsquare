---
import Layout from '@/layouts/Layout.astro';
import { ProductDetailsPage } from '@/components/ProductDetailsPage';
import catalogData from '@/data/catalog.json';
import catalog2Data from '@/data/catalog2.json';
import { buildProductBreadcrumbSchema } from '@/utils/seo';

export async function getStaticPaths() {
  const catalog2Ids = new Set(catalog2Data.map((p: any) => p?.id).filter(Boolean));
  const seenIds = new Set<string>();
  const allProducts = [...catalogData, ...catalog2Data].filter((product: any) => {
    if (!product?.id || seenIds.has(product.id)) return false;
    seenIds.add(product.id);
    return true;
  });

  return allProducts.map((product: any) => ({
    params: { id: product.id },
    props: { product, isCatalog2: catalog2Ids.has(product.id) },
  }));
}

const { product, isCatalog2 } = Astro.props;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": product.description,
  "sku": product.id,
  "image": [product.main_image, ...(product.additional_images || [])].filter(Boolean),
  "brand": {
    "@type": "Brand",
    "name": "المربع الفضي | Silver Square"
  }
};

const breadcrumbSchema = buildProductBreadcrumbSchema({
  lang: 'ar',
  isCatalog2,
  productId: product.id,
  productName: product.name,
});
---

<Layout 
  title={`المربع الفضي | ${product.name}`} 
  description={product.description}
  ogImage={product.main_image}
  structuredData={[productSchema, breadcrumbSchema]}
>
  <ProductDetailsPage product={product} client:load />
</Layout>
