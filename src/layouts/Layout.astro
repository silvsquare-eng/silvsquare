---
import { Header } from '@/components/Header';
import { Footer } from '@/components/Footer';
import { WhatsAppFAB } from '@/components/WhatsAppFAB';
import { ContactModal } from '@/components/ContactModal';
import { SITE_CONFIG } from '@/config/site';
import '@/index.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: 'ar' | 'en';
  structuredData?: Record<string, any> | Record<string, any>[];
}

const rawSeoTitle = SITE_CONFIG.seo?.title;
const defaultArTitle = rawSeoTitle
  ? (rawSeoTitle.includes('المربع الفضي') ? rawSeoTitle : rawSeoTitle.replace(/SilvSquare/gi, 'المربع الفضي'))
  : "المربع الفضي | تغليف مطاعم وكافيهات — من التصميم إلى باب الفرع";

const { 
  lang = 'ar',
  title = lang === 'en' ? "Silver Square | Packaging for Restaurants and Cafes" : defaultArTitle,
  description = lang === 'en' ? "A Saudi factory in Al Khobar specializing in packaging for restaurants and cafes. Design and printing of paper and plastic cups, coffee bags, food boxes, sandwich paper, and stickers. Delivery to all Saudi cities." : (SITE_CONFIG.seo?.description || "مصنع سعودي في الخبر متخصص في تغليف المطاعم والكافيهات. تصميم وطباعة أكواب ورقية وبلاستيكية، أكياس قهوة، بوكسات طعام، ورق ساندوتش، وستيكرات. تسليم لجميع مدن السعودية."),
  ogImage,
  structuredData
} = Astro.props;

const currentPath = Astro.url.pathname;
const dir = lang === 'en' ? 'ltr' : 'rtl';
const siteOrigin = Astro.site ? Astro.site.origin : Astro.url.origin;
const canonicalUrl = new URL(currentPath, siteOrigin).href;
const cleanArPath = currentPath.replace(/^\/en(\/|$)/, '/');
const cleanEnPath = `/en${cleanArPath === '/' ? '' : cleanArPath}`;
const arUrl = new URL(cleanArPath, siteOrigin).href;
const enUrl = new URL(cleanEnPath, siteOrigin).href;
const resolvedOgImage = ogImage ? new URL(ogImage, siteOrigin).href : new URL('/logo.jpg', siteOrigin).href;

const repsMap = SITE_CONFIG.reps || {};
const defaultWa = SITE_CONFIG.links?.whatsapp || '966542966582';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LocalBusiness"],
  "name": lang === 'en' ? "Silver Square" : "المربع الفضي للتعبئة والتغليف",
  "legalName": "المربع الفضي للتعبئة والتغليف",
  "alternateName": ["Silver Square", "SilvSquare", "المربع الفضي", "المربع الفضي للتعبئة والتغليف"],
  "url": "https://silvsquare.com",
  "logo": new URL('/logo.png', siteOrigin).href,
  "image": resolvedOgImage,
  "description": description,
  "taxID": "312743558700003",
  "vatID": "312743558700003",
  "identifier": {
    "@type": "PropertyValue",
    "name": "Commercial Registration",
    "value": "2051244352"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Al Khobar",
    "addressRegion": "Eastern Province",
    "addressCountry": "SA"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Saudi Arabia"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": `+${defaultWa}`,
    "contactType": "sales",
    "areaServed": "SA",
    "availableLanguage": ["Arabic", "English"]
  }
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content={lang === 'en' ? "restaurant packaging, cafe packaging, paper cups printing, coffee bags, food boxes, sandwich paper, restaurant stickers, Saudi packaging factory, Al Khobar, Silver Square" : "تغليف مطاعم, تغليف كافيهات, طباعة أكواب ورقية, أكياس قهوة, بوكسات طعام, ورق ساندوتش, ستيكرات مطاعم, مصنع تغليف السعودية, الخبر, المربع الفضي"}>
    <meta name="author" content={lang === 'en' ? "Silver Square Packaging" : "المربع الفضي للتعبئة والتغليف"} />
    <meta name="publisher" content={lang === 'en' ? "Silver Square Packaging" : "المربع الفضي للتعبئة والتغليف"} />
    <meta name="application-name" content={lang === 'en' ? "Silver Square" : "المربع الفضي"} />
    <meta name="apple-mobile-web-app-title" content={lang === 'en' ? "Silver Square" : "المربع الفضي"} />
    <meta name="theme-color" content="#E86011" />
    <meta name="geo.region" content="SA-04" />
    <meta name="geo.placename" content="Al Khobar, Saudi Arabia" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={arUrl} />

    <meta property="og:site_name" content={lang === 'en' ? "Silver Square" : "المربع الفضي للتعبئة والتغليف"} />
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:locale" content={lang === 'en' ? "en_US" : "ar_SA"}>
    <meta property="og:locale:alternate" content={lang === 'en' ? "ar_SA" : "en_US"}>
    <meta property="og:image" content={resolvedOgImage}>

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {structuredData && (Array.isArray(structuredData) ? structuredData : [structuredData]).map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <script is:inline define:vars={{ repsMap, defaultWa }}>
      (function () {
        function normalizePhone(phone) {
          var cleaned = String(phone || '').replace(/\D/g, '');
          if (cleaned.indexOf('00') === 0) cleaned = cleaned.substring(2);
          if (cleaned.indexOf('05') === 0 && cleaned.length === 10) cleaned = '966' + cleaned.substring(1);
          else if (cleaned.indexOf('5') === 0 && cleaned.length === 9) cleaned = '966' + cleaned;
          return cleaned;
        }

        function emitRepUpdated(num) {
          try {
            window.dispatchEvent(new CustomEvent('sales-rep-updated', { detail: { phoneNumber: num } }));
          } catch (e) {}
        }

        try {
          var params = new URLSearchParams(window.location.search);
          var rep = params.get('rep') || params.get('phone') || params.get('wa') || params.get('num') || params.get('id');
          if (!rep && window.location.search.length > 1) {
            params.forEach(function (val, key) {
              var cleanKey = key ? key.trim() : '';
              if (!rep && !val && cleanKey && ['cat', 'catalog', 'type'].indexOf(cleanKey.toLowerCase()) === -1) {
                rep = cleanKey;
              }
            });
          }
          if (rep && rep.trim()) {
            localStorage.setItem('sales_rep', rep.trim());
          } else {
            rep = localStorage.getItem('sales_rep');
          }

          var activeNumber = normalizePhone(defaultWa);
          if (rep && rep.trim()) {
            var trimmedRep = rep.trim();
            var lower = trimmedRep.toLowerCase();
            var matched = false;
            if (repsMap && typeof repsMap === 'object') {
              Object.keys(repsMap).forEach(function (k) {
                if (k.trim().toLowerCase() === lower && repsMap[k]) {
                  activeNumber = normalizePhone(repsMap[k]);
                  matched = true;
                }
              });

              if (!matched) {
                var normalizedInput = normalizePhone(trimmedRep);
                if (normalizedInput.length >= 9) {
                  Object.keys(repsMap).forEach(function (k) {
                    if (!matched && repsMap[k]) {
                      var normVal = normalizePhone(repsMap[k]);
                      if (normVal === normalizedInput || normVal.slice(-normalizedInput.length) === normalizedInput) {
                        activeNumber = normVal;
                        matched = true;
                      }
                    }
                  });
                }
              }
            }
            if (!matched) {
              var digits = trimmedRep.replace(/\D/g, '');
              if (digits.length >= 9 && digits.length <= 15) {
                activeNumber = normalizePhone(trimmedRep);
              }
            }
          }

          window.__ACTIVE_WA_NUMBER__ = activeNumber;
          emitRepUpdated(activeNumber);

          function updateAllContactLinks() {
            var num = window.__ACTIVE_WA_NUMBER__;
            if (!num) return;

            var waAnchors = document.querySelectorAll('a[href*="wa.me/"]');
            waAnchors.forEach(function (a) {
              var href = a.getAttribute('href');
              if (href) {
                var updated = href.replace(/wa\.me\/[0-9+]+/, 'wa.me/' + num);
                if (updated !== href) a.setAttribute('href', updated);
              }
            });

            var apiAnchors = document.querySelectorAll('a[href*="api.whatsapp.com/send"]');
            apiAnchors.forEach(function (a) {
              var href = a.getAttribute('href');
              if (href) {
                try {
                  var parsed = new URL(href, window.location.origin);
                  if (parsed.searchParams.get('phone') !== num) {
                    parsed.searchParams.set('phone', num);
                    a.setAttribute('href', parsed.toString());
                  }
                } catch (err) {
                  var updatedApi = /([?&])phone=[^&]*/.test(href)
                    ? href.replace(/([?&])phone=[^&]*/, '$1phone=' + num)
                    : href + (href.indexOf('?') === -1 ? '?phone=' : '&phone=') + num;
                  if (updatedApi !== href) a.setAttribute('href', updatedApi);
                }
              }
            });

            var telAnchors = document.querySelectorAll('a[href^="tel:"]');
            telAnchors.forEach(function (a) {
              var href = a.getAttribute('href');
              var targetTel = 'tel:+' + num;
              if (href && href !== targetTel) {
                a.setAttribute('href', targetTel);
              }
            });
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
              updateAllContactLinks();
              emitRepUpdated(activeNumber);
            });
          } else {
            updateAllContactLinks();
          }

          var observer = new MutationObserver(updateAllContactLinks);
          document.addEventListener('DOMContentLoaded', function () {
            if (document.body) {
              observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['href'] });
            }
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="min-h-[100dvh]" dir={dir}>
      <Header currentPath={currentPath} lang={lang} client:load />
      <main>
        <slot />
      </main>
      <Footer lang={lang} client:idle />
      <WhatsAppFAB lang={lang} client:idle />
      <ContactModal lang={lang} client:load />
    </div>
  </body>
</html>
